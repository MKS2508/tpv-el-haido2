{
  "name": "tpv-el-haido",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "mks-dev-session start",
    "dev:no-attach": "mks-dev-session start --no-attach",
    "dev:attach": "mks-dev-session attach",
    "dev:stop": "mks-dev-session stop",
    "dev:restart": "mks-dev-session restart",
    "dev:status": "mks-dev-session status",
    "dev:kill": "mks-dev-session kill",
    "dev:vite": "vite",
    "tauri:dev": "tauri dev",
    "dev:full": "bun run prebuild && concurrently -k -n LICENSE,TAURI -c cyan,magenta \"bun run license-server\" \"bun run tauri:dev\"",
    "dev:all": "bun run prebuild && concurrently -k -n LICENSE,DOCS,TAURI -c cyan,yellow,magenta \"bun run license-server\" \"bun run docs\" \"bun run tauri:dev\"",
    "prebuild": "bun run scripts/prebuild-sidecars.ts",
    "build": "tsgo --noEmit && vite build",
    "build:tsc": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "deploy:rpi": "npm run build && npm run tauri build -- --target aarch64-unknown-linux-gnu",
    "docs:rpi": "node --loader tsx generate-docs.ts || bun run generate-docs.ts",
    "build:rpi-full": "npm run deploy:rpi && npm run docs:rpi",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "lint:solid": "eslint src --config eslint.config.js",
    "lint:ox": "oxlint src",
    "format": "biome format --write src",
    "check": "biome check --write src && eslint src --config eslint.config.js",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "check:roadmap": "axon gen --out docs --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:aeat-sidecar": "bun run scripts/build-aeat-sidecar.ts",
    "build:aeat-sidecar:all": "bun run scripts/build-aeat-sidecar.ts --target all",
    "seed": "bun run scripts/seed.ts",
    "seed:clear": "bun run scripts/seed.ts --clear",
    "license-server": "bun run --cwd apps/license-server dev",
    "license-server:build": "bun run --cwd apps/license-server build",
    "license-server:start": "bun run --cwd apps/license-server start",
    "docs": "bun run --cwd apps/haidodocs dev",
    "docs:build": "bun run --cwd apps/haidodocs build",
    "docs:start": "bun run --cwd apps/haidodocs start",
    "docs:typecheck": "bun run --cwd apps/haidodocs types:check",
    "apps:license": "bun run license-server",
    "apps:docs": "bun run docs",
    "build:pwa": "bun run scripts/build-pwa.ts",
    "deploy:pwa": "bun run build:pwa && bun run --cwd apps/haidodocs build",
    "release:macos": "bun run scripts/build-release.ts --target macos-arm64",
    "release:windows": "bun run scripts/build-release.ts --target windows-x64",
    "release:all": "bun run scripts/build-release.ts --target all",
    "release:auth-login": "bun run scripts/release.ts auth login",
    "release:auth-status": "bun run scripts/release.ts auth status",
    "release:publish": "bun run scripts/release.ts publish",
    "commit": "bun node_modules/gemini-commit-wizard/src/commit-ui.ts",
    "commit:quick": "bun node_modules/gemini-commit-wizard/src/commit-ui.ts --quick",
    "commit:manual": "bun node_modules/gemini-commit-wizard/src/commit-generator.ts",
    "commit:auto": "bun node_modules/gemini-commit-wizard/src/commit-generator.ts --auto-approve",
    "commit:dry": "bun node_modules/gemini-commit-wizard/src/commit-generator.ts --dry-run",
    "version:minor": "bun node_modules/gemini-commit-wizard/src/version-manager.ts --type minor",
    "version:major": "bun node_modules/gemini-commit-wizard/src/version-manager.ts --type major",
    "version:patch": "bun node_modules/gemini-commit-wizard/src/version-manager.ts --type patch",
    "version:beta": "bun node_modules/gemini-commit-wizard/src/version-manager.ts --prefix beta",
    "version:sync": "bun node_modules/gemini-commit-wizard/src/version-manager.ts --sync"
  },
  "dependencies": {
    "@amad3v/solid-chart": "^1.0.4",
    "@kobalte/core": "^0.13.9",
    "@mks2508/better-logger": "0.18.3",
    "@mks2508/no-throw": "^0.3.7",
    "@mks2508/shadcn-basecoat-theme-manager": "^4.3.2",
    "@mks2508/tickmaster": "^0.1.0",
    "@motionone/solid": "^10.13.2",
    "@tanstack/solid-virtual": "^3.13.23",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-http": "^2.5.8",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-solid": "^1.7.0",
    "modern-screenshot": "^4.6.8",
    "oauth4webapi": "^3.8.6",
    "solid-js": "^1.9.12",
    "solid-sonner": "^0.3.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@mks2508/mks-dev-session": "latest",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2.10.1",
    "@types/esc-pos-encoder": "^1.3.4",
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^25.5.2",
    "@typescript-eslint/parser": "^8.58.1",
    "@typescript/native-preview": "^7.0.0-dev.20260408.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^9.1.2",
    "eslint": "^10.2.0",
    "eslint-plugin-solid": "^0.14.5",
    "fake-indexeddb": "^6.2.5",
    "gemini-commit-wizard": "2.1.1",
    "jscodeshift": "^17.3.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.59.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.11"
  }
}
