# Logger Configuration
# Log level: debug | info | warn | error | critical
VITE_LOG_LEVEL=debug

# Transport Configuration - Console
VITE_LOG_CONSOLE=true

# Transport Configuration - File (Tauri desktop only)
# Logs to: {app_data_dir}/{VITE_LOG_FILE_PATH}
VITE_LOG_FILE=false
VITE_LOG_FILE_PATH=tpv-haido.log

# Transport Configuration - HTTP (Remote server)
# Requires VITE_LOG_HTTP_URL to be set
VITE_LOG_HTTP=false
VITE_LOG_HTTP_URL=https://logs.example.com/api/logs

# Create a local .env file with your overrides (gitignored)
