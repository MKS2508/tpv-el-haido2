{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TPV El Haido",
  "version": "0.2.1",
  "identifier": "com.elhaido.tpv",
  "build": {
    "beforeDevCommand": "bun run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "windows": [
            "*"
          ],
          "permissions": [
            "core:default",
            "shell:default",
            "http:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "sidecars/aeat-bridge"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/square-icon-256.png",
      "icons/square-icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Business",
    "publisher": "mks2508",
    "shortDescription": "TPV para hostelería",
    "longDescription": "Sistema de punto de venta para restaurantes y bares, con cumplimiento fiscal AEAT VerificaTu, gestión de productos, impresión térmica y autenticación por PIN.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCMEJCRjQ0MzM0RUJCQjEKUldTeHUwNHpSTDhMMjUwd042MUg0eHZhU1c4R21BR0JPSVB0cW1SYkt3NkM5Wk5sQzlWcmxVVVUK",
      "endpoints": [
        "https://haido.releases.mks2508.systems/api/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
