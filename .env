# Local development environment variables
# Copy from .env.example and customize as needed

# Debug / Dev mode (bypasses license validation, uses enterprise license)
VITE_DEBUG_MODE=true

# Logger Configuration
VITE_LOG_LEVEL=debug
VITE_LOG_CONSOLE=true
VITE_LOG_FILE=true
VITE_LOG_FILE_PATH=tpv-haido.log
VITE_LOG_HTTP=false
# VITE_LOG_HTTP_URL=https://logs.example.com/api/logs
