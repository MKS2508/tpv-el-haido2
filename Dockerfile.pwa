FROM oven/bun:1 AS builder
WORKDIR /app

COPY package.json bun.lockb ./
RUN bun install --frozen-lockfile

COPY . .
ARG PWA_BUILD=true
ENV PWA_BUILD=${PWA_BUILD}
RUN bun run build

FROM nginx:alpine AS production

RUN apk add --no-cache curl

COPY --from=builder /app/dist /usr/share/nginx/html

COPY nginx.pwa.conf /etc/nginx/conf.d/default.conf

RUN echo '<!DOCTYPE html><html><head><title>TPV PWA</title></head><body><h1>TPV Haido PWA is running!</h1><p>Path: /</p></body></html>' > /usr/share/nginx/html/test.html

EXPOSE 1420

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:1420/ || curl -f http://localhost:1420/test.html || exit 1

CMD ["nginx", "-g", "daemon off;"]
