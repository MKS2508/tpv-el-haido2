{
  "name": "haidodocs-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "biome check",
    "format": "biome format --write",
    "manual:md": "bun run scripts/generate-manual.ts",
    "manual:pdf": "bun run scripts/generate-pdf.ts",
    "manual:all": "bun run manual:md && bun run manual:pdf",
    "manual:fix-html": "bun run scripts/fix-manual-html.ts"
  },
  "dependencies": {
    "fumadocs-core": "16.7.11",
    "fumadocs-mdx": "14.2.11",
    "fumadocs-ui": "16.7.11",
    "lucide-react": "^1.7.0",
    "mermaid": "^11.14.0",
    "next": "16.2.2",
    "next-intl": "^4.9.0",
    "playwright": "^1.59.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rehype-mermaid": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "@biomejs/biome": "^2.4.10"
  }
}
