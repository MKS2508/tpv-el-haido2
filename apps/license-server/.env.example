# License Server - Environment Variables
# Copiar a .env.local para overrides locales (no se commitea)

# === Server Configuration ===
PORT=3002
NODE_ENV=development
LICENSE_SERVER_URL=http://localhost:3002

# === Debug Mode ===
# Permite Bearer token "test" para desarrollo
DEBUG_MODE=false

# === Admin Authentication ===
# Token para endpoints admin (CAMBIAR en producción)
ADMIN_TOKEN=your-secure-admin-token-change-me

# === Database ===
DB_PATH=./db/licenses.db

# === Logging ===
LOG_LEVEL=debug
LOG_PRESET=cyberpunk
